@page "/reporting/merchant-settlement-history"
@rendermode InteractiveServer

<PageTitle>Merchant Settlement History</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Merchant Settlement History</h1>
            <p class="text-gray-600 mt-1">Historical settlement visibility per merchant</p>
        </div>
        <a href="/reporting" class="btn btn-secondary">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Reporting
        </a>
    </div>

    <div class="card">
        <div class="card-body text-center py-12">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <p class="text-gray-600 text-lg">No settlement history found for the selected criteria</p>
            <p class="text-gray-500 text-sm mt-2">Try adjusting your date range or merchant selection</p>
        </div>
    </div>
</div>
